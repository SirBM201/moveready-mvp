ENV_MODE=development
FLASK_ENV=development
PORT=8000
# Required in production. Generate a long random value and store it only in Railway.
SECRET_KEY=
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Canonical Railway variable. GitHub Actions uses MOVEREADY_ADMIN_KEY for the
# same value, and protected requests send X-MoveReady-Admin-Key.
MOVEREADY_ADMIN_API_KEY=
# Legacy development aliases; leave blank in new production configuration.
MOVE_READY_ADMIN_API_KEY=
ADMIN_API_KEY=

# Account OTP and sessions
AUTH_OTP_EXPIRES_MINUTES=10
AUTH_MAX_CODE_ATTEMPTS=5
AUTH_SESSION_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS_PER_EMAIL=10
AUTH_OTP_REQUEST_COOLDOWN_SECONDS=60
AUTH_OTP_REQUEST_WINDOW_MINUTES=15
AUTH_OTP_MAX_REQUESTS_PER_EMAIL_WINDOW=5
AUTH_OTP_MAX_REQUESTS_PER_IP_WINDOW=20
AUTH_OTP_RECENT_SCAN_LIMIT=300
AUTH_OTP_DEV_MODE=false

EMAIL_OTP_DELIVERY_ENABLED=false
EMAIL_OTP_PROVIDER=mailtrap
EMAIL_OTP_APP_NAME=MoveReady
EMAIL_OTP_LOGIN_URL=http://localhost:3000/login
EMAIL_OTP_FROM=
EMAIL_OTP_REPLY_TO=
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_SANDBOX_API_TOKEN=
MAILTRAP_SANDBOX_ID=
MAILTRAP_SANDBOX_API_URL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

PLATFORM_MODULES_ENABLED=true
OPPORTUNITY_ALERTS_ENABLED=false
WHATSAPP_ALERTS_ENABLED=false
VISA_POWER_ENABLED=true

# Commercial controls
COMMERCIAL_QUOTES_ENABLED=true
PAYMENT_LINKS_ENABLED=false

# MR Billing 02 — Paystack. Secret key is backend-only; never expose or commit a real value.
PAYSTACK_SECRET_KEY=
PAYSTACK_API_BASE=https://api.paystack.co
PAYSTACK_TIMEOUT_SECONDS=20
# Fully qualified MoveReady frontend return URL. A callback visit is never treated as proof of payment.
PAYSTACK_CALLBACK_URL=
# Configure the Paystack Dashboard webhook to POST to:
# https://<backend-host>/api/billing/paystack/webhook

# Passport Index / Visa Power provider cache
PASSPORT_INDEX_PROVIDER_ENABLED=false
PASSPORT_INDEX_PROVIDER_NAME=MoveReady starter cache
PASSPORT_INDEX_PROVIDER_URL=
PASSPORT_INDEX_PROVIDER_KEY=
PASSPORT_INDEX_PROVIDER_METHOD=GET
PASSPORT_INDEX_PROVIDER_AUTH_HEADER=X-API-Key
PASSPORT_INDEX_PROVIDER_HOST_HEADER=
PASSPORT_INDEX_PROVIDER_EXTRA_HEADERS_JSON={}
PASSPORT_INDEX_PROVIDER_COUNTRY_CODE_FORMAT=alpha2
PASSPORT_INDEX_PROVIDER_TIMEOUT_SECONDS=20
PASSPORT_INDEX_CACHE_MAX_DAYS=7
PASSPORT_INDEX_SYNC_WEEKDAYS=FRI
PASSPORT_INDEX_SYNC_HOUR_UTC=6
PASSPORT_INDEX_SYNC_MINUTE_UTC=17
PASSPORT_INDEX_SCHEDULED_COUNTRIES=Nigeria
PASSPORT_INDEX_MAX_COUNTRIES_PER_SYNC=1
PASSPORT_INDEX_DETAIL_PROVIDER_URL=
PASSPORT_INDEX_DETAIL_CACHE_MAX_DAYS=7

# Example for the TravelBuddyAI RapidAPI provider:
# PASSPORT_INDEX_PROVIDER_URL=https://visa-requirement.p.rapidapi.com/v2/visa/map
# PASSPORT_INDEX_DETAIL_PROVIDER_URL=https://visa-requirement.p.rapidapi.com/v2/visa/check
# PASSPORT_INDEX_PROVIDER_AUTH_HEADER=X-RapidAPI-Key
# PASSPORT_INDEX_PROVIDER_HOST_HEADER=visa-requirement.p.rapidapi.com
# PASSPORT_INDEX_PROVIDER_METHOD=POST

DOCUMENT_CHECKS_ENABLED=false
PROOF_OF_FUNDS_PLANNER_ENABLED=false
REFUSAL_ANALYZER_ENABLED=false
LEGALIZATION_MODULE_ENABLED=false
COURIER_MODULE_ENABLED=false
INSURANCE_PARTNER_ENABLED=false
APPOINTMENT_TRACKER_ENABLED=false
FAMILY_PLANNER_ENABLED=false
SETTLEMENT_MODULE_ENABLED=false
PARTNER_MARKETPLACE_ENABLED=false
